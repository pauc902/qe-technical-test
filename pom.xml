<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Who this project is: a unique name, like an address for the project -->
    <groupId>com.example.qe</groupId>
    <artifactId>qe-practice</artifactId>
    <version>1.0.0</version>
    <name>QE Practice - Playwright Java (API + UI)</name>

    <properties>
        <!-- Compile for Java 17 -->
        <maven.compiler.release>17</maven.compiler.release>
        <!-- Read source files as UTF-8 so special characters behave the same on every machine -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Library versions in one place, so each can be changed in a single line -->
        <playwright.version>1.64.0</playwright.version>
        <junit.version>5.11.3</junit.version>
        <junit.platform.version>1.11.3</junit.platform.version>
        <assertj.version>3.26.3</assertj.version>
        <jackson.version>2.18.1</jackson.version>
    </properties>

    <!-- scope "test": these libraries are only used by test code, never shipped -->
    <dependencies>
        <!-- Playwright: controls the browser (UI tests) and sends HTTP requests (API tests) -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5: the test runner. Decides what is a test, runs it, reports pass/fail -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit launcher API: lets our results-table listener hook into the test run -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>${junit.platform.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- AssertJ: readable checks, e.g. assertThat(status).isEqualTo(200) -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Jackson: converts JSON from the API into Java objects and back -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
